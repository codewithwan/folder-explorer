import { CheckBox, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnChoice, ColumnInfo, Crumb, DriveCard, FileRow, SummaryRow, TreemapTile, TreeRow } from "types.slint";
import { CaptionButton, CommandButton, DimLabel, IconButton, IndeterminateBar, Label, LoadingSpinner, MenuPopover, PopoverItem, SubmenuPopover, UsageBar } from "controls.slint";
import { FileGrid } from "file_grid.slint";
import { FileTable } from "file_table.slint";
import { DrivesView, ErrorPanel, Sidebar, SummaryPane } from "panes.slint";
import { StorageDock } from "storagedock.slint";

export { ColumnChoice, ColumnInfo, Crumb, DriveCard, FileRow, SummaryRow, TreemapTile, TreeRow }

component TitleBar inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <bool> maximized;
    callback minimize-requested();
    callback maximize-toggled();
    callback close-requested();

    height: Theme.titlebar-height;
    background: transparent;

    HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;

        Rectangle {
            width: 16px;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
            }
        }

        DimLabel {
            text: root.title;
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            spacing: 0;

            CaptionButton {
                icon: @image-url("icons/minimize.svg");
                label: "Minimize";
                clicked => { root.minimize-requested(); }
            }

            CaptionButton {
                icon: root.maximized ? @image-url("icons/restore.svg") : @image-url("icons/maximize.svg");
                label: root.maximized ? "Restore" : "Maximize";
                clicked => { root.maximize-toggled(); }
            }

            CaptionButton {
                icon: @image-url("icons/close.svg");
                label: "Close";
                danger: true;
                clicked => { root.close-requested(); }
            }
        }
    }
}

component Breadcrumbs {
    in property <[Crumb]> crumbs;
    in property <string> path;
    callback crumb-clicked(string);
    callback path-entered(string);

    property <bool> editing;

    public function edit() {
        root.editing = true;
        editor.text = root.path;
        editor.focus();
        editor.select-all();
    }

    height: 34px;
    horizontal-stretch: 1;

    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: edit-touch.has-hover ? Theme.input-border-hover : Theme.input-border;
        background: edit-touch.has-hover ? Theme.input-hover : Theme.input-bg;
        visible: !root.editing;
        animate background { duration: 120ms; easing: ease-out; }
    }

    edit-touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: text;
        clicked => { root.edit(); }
    }

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        clip: true;
        visible: !root.editing;

        HorizontalLayout {
            x: min(0px, parent.width - self.preferred-width);
            width: self.preferred-width;
            padding-left: 2px;
            padding-right: 4px;
            spacing: 0;

            for crumb[index] in root.crumbs: HorizontalLayout {
                if index > 0: Rectangle {
                    width: 12px;

                    Image {
                        source: @image-url("icons/chevron-right.svg");
                        width: 12px;
                        height: 12px;
                        colorize: Theme.text-faint;
                    }
                }

                Rectangle {
                    min-width: crumb-layout.preferred-width + 12px;
                    horizontal-stretch: 0;

                    Rectangle {
                        y: 4px;
                        height: parent.height - 8px;
                        border-radius: Theme.radius-sm;
                        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
                    }

                    crumb-layout := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;

                        if index == 0: Rectangle {
                            width: 14px;

                            Image {
                                source: @image-url("icons/computer.svg");
                                width: 14px;
                                height: 14px;
                                colorize: root.crumbs.length == 1 ? Theme.accent : Theme.text-dim;
                            }
                        }

                        Label {
                            text: crumb.name;
                            font-weight: index == root.crumbs.length - 1 ? 600 : 400;
                            color: index == root.crumbs.length - 1 || touch.has-hover ? Theme.text : Theme.text-dim;
                            overflow: clip;
                            horizontal-alignment: center;
                        }
                    }

                    touch := TouchArea {
                        clicked => { root.crumb-clicked(crumb.target); }
                    }
                }
            }
        }
    }

    editor := LineEdit {
        visible: root.editing;
        width: parent.width;
        height: parent.height;
        accepted(text) => {
            root.editing = false;
            root.path-entered(text);
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.editing = false;
                return accept;
            }
            reject
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.editing = false;
            }
        }
    }
}

component SearchBox inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> placeholder-text;
    in-out property <string> text <=> input.text;
    callback edited();
    callback accepted();
    callback cleared();

    height: 34px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: !root.enabled || input.has-focus
        ? Theme.line
        : bg-touch.has-hover
            ? Theme.input-border-hover
            : Theme.input-border;
    background: !root.enabled
        ? (Theme.dark ? #ffffff06 : #f9f9f966)
        : input.has-focus
            ? Theme.input-active
            : bg-touch.has-hover
                ? Theme.input-hover
                : Theme.input-bg;
    animate background { duration: 120ms; easing: ease-out; }
    forward-focus: input;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;

    bg-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
                color: !root.enabled ? Theme.text-faint : Theme.text-dim;
                accessible-role: none;
            }

            ContextMenuArea {
                enabled: root.enabled;

                Menu {
                    MenuItem {
                        title: @tr("Undo");
                        activated => { input.undo(); }
                    }
                    MenuItem {
                        title: @tr("Redo");
                        activated => { input.redo(); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Cut");
                        activated => { input.cut(); }
                    }
                    MenuItem {
                        title: @tr("Copy");
                        enabled: !root.text.is-empty;
                        activated => { input.copy(); }
                    }
                    MenuItem {
                        title: @tr("Paste");
                        activated => { input.paste(); }
                    }
                    MenuItem {
                        title: @tr("Select All");
                        enabled: !root.text.is-empty;
                        activated => { input.select-all(); }
                    }
                }

                input := TextInput {
                    property <length> computed-x;

                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    enabled: root.enabled;
                    vertical-alignment: center;
                    single-line: true;
                    color: root.enabled ? Theme.text : Theme.text-faint;
                    selection-background-color: Palette.selection-background;
                    selection-foreground-color: Palette.accent-foreground;
                    accessible-role: none;

                    cursor-position-changed(pos) => {
                        if (pos.x + self.computed-x < 0px) {
                            self.computed-x = -pos.x;
                        } else if (pos.x + self.computed-x > parent.width - self.text-cursor-width) {
                            self.computed-x = parent.width - pos.x - self.text-cursor-width;
                        }
                    }

                    edited => { root.edited(); }
                    accepted => { root.accepted(); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.text = "";
                            root.cleared();
                            return accept;
                        }
                        reject
                    }
                }
            }
        }

        Rectangle {
            width: 26px;

            if root.text == "": Image {
                width: 15px;
                height: 15px;
                source: @image-url("icons/search.svg");
                colorize: root.enabled ? Theme.text-dim : Theme.text-faint;
            }

            if root.text != "": Rectangle {
                width: 26px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: clear-search.pressed ? Theme.pressed : clear-search.has-hover ? Theme.hover : transparent;

                Image {
                    width: 13px;
                    height: 13px;
                    source: @image-url("icons/stop.svg");
                    colorize: clear-search.has-hover ? Theme.text : Theme.text-dim;
                }

                clear-search := TouchArea {
                    clicked => {
                        root.text = "";
                        root.cleared();
                    }
                }
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        width: input.has-focus ? parent.width - 2 * parent.border-radius : 0px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
        opacity: input.has-focus ? 1 : 0;
        animate width { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 120ms; easing: ease-out; }
    }
}

component SearchFilters {
    in-out property <bool> size-enabled;
    in-out property <int> size-rule;
    in-out property <string> size-text;
    in-out property <bool> date-enabled;
    in-out property <int> date-field;
    in-out property <int> date-rule;
    in-out property <string> date-text;
    callback changed();

    height: 44px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        alignment: start;

        CheckBox {
            text: "Size";
            checked <=> root.size-enabled;
            toggled => { root.changed(); }
        }

        ComboBox {
            width: 120px;
            model: ["more than", "less than"];
            current-index <=> root.size-rule;
            selected => { root.changed(); }
        }

        LineEdit {
            width: 90px;
            input-type: decimal;
            placeholder-text: "MB";
            text <=> root.size-text;
            edited => { root.changed(); }
        }

        Rectangle {
            width: 17px;

            Rectangle {
                width: 1px;
                height: 20px;
                background: Theme.line;
            }
        }

        CheckBox {
            text: "Date";
            checked <=> root.date-enabled;
            toggled => { root.changed(); }
        }

        ComboBox {
            width: 120px;
            model: ["modified", "created", "accessed"];
            current-index <=> root.date-field;
            selected => { root.changed(); }
        }

        ComboBox {
            width: 100px;
            model: ["after", "before", "on"];
            current-index <=> root.date-rule;
            selected => { root.changed(); }
        }

        LineEdit {
            width: 130px;
            placeholder-text: "YYYY-MM-DD";
            text <=> root.date-text;
            edited => { root.changed(); }
        }

        if root.size-enabled || root.date-enabled: CommandButton {
            icon: @image-url("icons/stop.svg");
            text: "Reset";
            clicked => {
                root.size-enabled = false;
                root.date-enabled = false;
                root.size-text = "";
                root.date-text = "";
                root.changed();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Folder Explorer";
    icon: @image-url("icons/app.svg");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 5px;
    min-width: 760px;
    min-height: 440px;
    background: Theme.window-bg;
    default-font-family: "Segoe UI";
    default-font-size: Theme.text-size;

    in property <[ColumnInfo]> columns;
    in property <[FileRow]> rows;
    in property <length> columns-width;
    in property <[TreeRow]> tree-rows;
    in property <[Crumb]> crumbs;
    in property <string> current-path;
    in property <[DriveCard]> drives;
    in property <[DriveCard]> network-drives;
    in property <[SummaryRow]> summary-rows;
    in property <[TreemapTile]> summary-treemap;
    in property <image> summary-chart-image;
    in property <string> summary-total-size;
    in property <int> summary-kind;
    in-out property <int> summary-viz-mode: 0;
    in-out property <int> summary-hovered-index: -1;
    in property <string> summary-hint;
    in property <[ColumnChoice]> column-choices;
    in property <[string]> errors;
    in property <string> list-message;
    in property <bool> showing-drives: true;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-up;
    in property <bool> busy;
    in property <bool> can-search;
    in property <string> status-items;
    in property <string> status-selection;
    in property <string> status-activity;
    in property <string> status-errors;
    in property <string> disk-text;
    in property <float> disk-ratio;
    in property <bool> disk-nearly-full;
    in property <int> selected-count;
    in property <bool> single-selection;
    in property <bool> in-search-results;
    in property <bool> can-edit-folder;
    in property <bool> can-paste;
    in property <[ColumnChoice]> sort-choices;
    in property <string> recycle-bin-title: "Empty Recycle Bin";
    in-out property <int> unit-index;
    in-out property <int> view-index: 5;
    in-out property <bool> show-hidden;
    in-out property <bool> summary-open;
    in-out property <length> sidebar-width: 240px;
    in-out property <string> search-text;
    in-out property <bool> filters-open;
    in-out property <bool> size-enabled;
    in-out property <int> size-rule;
    in-out property <string> size-text;
    in-out property <bool> date-enabled;
    in-out property <int> date-field;
    in-out property <int> date-rule;
    in-out property <string> date-text;

    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh-or-stop();
    callback open-location(string);
    callback path-entered(string);
    callback tree-opened(int);
    callback tree-toggled(int);
    callback sort-requested(int);
    callback column-resized(int, length);
    callback row-pressed(int, bool, bool);
    callback row-context(int);
    callback row-activated(int);
    callback background-pressed();
    callback cursor-moved(int, bool);
    callback search-changed();
    callback summary-kind-chosen(int);
    callback summary-viz-mode-chosen(int);
    callback summary-wheel-hovered(float, float);
    callback summary-row-hovered(int);
    callback summary-activated(int);
    callback unit-chosen(int);
    callback column-toggled(int);
    callback hidden-toggled();
    callback summary-toggled();
    callback action(string);
    callback cancel-pressed();
    callback view-chosen(int);
    callback sort-chosen(int);
    callback menu-opening();
    callback rename-committed(string);
    callback rename-cancelled();
    callback text-typed(string);

    property <bool> errors-open;
    property <length> summary-width: 344px;
    property <bool> details: root.view-index == 5;
    property <int> vertical-step: root.details ? 1 : grid.vertical-step;
    property <int> horizontal-step: root.details ? 0 : grid.horizontal-step;
    property <int> page-step: root.details ? 20 : grid.page-step;
    property <[string]> view-titles: ["Extra large icons", "Large icons", "Medium icons", "Small icons", "List", "Details", "Tiles"];
    property <[image]> view-icons: [@image-url("icons/view-extra-large.svg"), @image-url("icons/view-large.svg"), @image-url("icons/view-medium.svg"), @image-url("icons/view-small.svg"), @image-url("icons/view-list.svg"), @image-url("icons/view-details.svg"), @image-url("icons/view-tiles.svg")];
    property <int> header-menu;
    property <length> menu-anchor-x;
    property <length> menu-anchor-y;
    property <[string]> unit-titles: ["Automatic", "Bytes", "Kilobytes", "Megabytes", "Gigabytes", "Terabytes"];
    property <[string]> more-titles: ["Size unit", "Columns", "Show hidden items", "Export list…", root.recycle-bin-title];
    property <[image]> more-icons: [@image-url("icons/drive.svg"), @image-url("icons/view-details.svg"), @image-url("icons/eye.svg"), @image-url("icons/export.svg"), @image-url("icons/delete.svg")];

    function show-header-menu(menu: int, x: length, y: length) {
        if (header-popover.open && root.header-menu == menu) {
            header-popover.open = false;
            return;
        }
        root.header-menu = menu;
        header-popover.submenu-open = 0;
        header-popover.submenu-index = -1;
        header-popover.current-index = -1;
        root.menu-anchor-x = x;
        root.menu-anchor-y = y;
        header-popover.open = true;
    }

    function activate-header-item(index: int) {
        if (!header-popover.open) { return; }
        if (root.header-menu == 1) {
            root.sort-chosen(index);
        } else if (root.header-menu == 2) {
            root.view-chosen(index);
        } else if (index < 2) {
            header-popover.submenu-open = index + 1;
            header-popover.submenu-index = 0;
            return;
        } else if (index == 2) {
            root.show-hidden = !root.show-hidden;
            root.hidden-toggled();
        } else if (index == 3) {
            if (root.showing-drives) { return; }
            header-popover.open = false;
            root.action("export");
            return;
        } else {
            header-popover.open = false;
            root.action("empty-bin");
            return;
        }
        header-popover.open = false;
    }

    function activate-submenu-item(index: int) {
        if (!header-popover.open) { return; }
        if (header-popover.submenu-open == 1) {
            root.unit-chosen(index);
            header-popover.open = false;
        } else if (header-popover.submenu-open == 2) {
            root.column-toggled(index);
        }
    }

    public function reveal-row(row: int) {
        if (root.details) {
            table.reveal-row(row);
        } else {
            grid.reveal-row(row);
        }
    }

    public function reveal-tree-row(row: int) {
        sidebar.reveal-row(row);
    }

    public function scroll-to-top() {
        table.scroll-to-top();
        grid.scroll-to-top();
    }

    public function focus-list() {
        if (root.details) {
            table.take-focus();
        } else {
            grid.take-focus();
        }
    }

    public function begin-rename(row: int, name: string, selection-end: int) {
        if (root.details) {
            table.begin-rename(row, name, selection-end);
        } else {
            grid.begin-rename(row, name, selection-end);
        }
    }

    public function show-list-menu(row: int) {
        if (row >= 0) {
            root.reveal-row(row);
        }
        root.menu-opening();
        let anchor = root.details ? table.menu-anchor(max(row, 0)) : grid.menu-anchor(max(row, 0));
        list-menu.show({ x: anchor.x, y: anchor.y + list-menu.banner-height });
    }

    forward-focus: keys;

    keys := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.modifiers.alt && event.text == Key.LeftArrow) { root.go-back(); return accept; }
            if (event.modifiers.alt && event.text == Key.RightArrow) { root.go-forward(); return accept; }
            if (event.modifiers.alt && event.text == Key.UpArrow) { root.go-up(); return accept; }
            if (event.modifiers.alt && event.text == Key.Return) { root.action("properties"); return accept; }
            if (event.modifiers.alt && (event.text == "d" || event.text == "D")) { breadcrumbs.edit(); return accept; }
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) { root.action("context-menu"); return accept; }
            if (event.text == Key.F5) { root.action("refresh"); return accept; }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) { root.action("refresh"); return accept; }
            if (event.text == Key.Escape && root.errors-open) { root.errors-open = false; return accept; }
            if (event.text == Key.Escape) { root.cancel-pressed(); return accept; }
            if (event.text == Key.F3) { search-box.focus(); return accept; }
            if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "e" || event.text == "E")) { search-box.focus(); return accept; }
            if (event.text == Key.F4) { breadcrumbs.edit(); return accept; }
            if (event.modifiers.control && (event.text == "l" || event.text == "L")) { breadcrumbs.edit(); return accept; }
            if (event.text == Key.F2) { root.action("rename"); return accept; }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "n" || event.text == "N")) { root.action("new-folder"); return accept; }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) { root.action("copy-path"); return accept; }
            if (event.modifiers.control && (event.text == "d" || event.text == "D")) { root.action("delete"); return accept; }
            if (event.modifiers.control && (event.text == "x" || event.text == "X")) { root.action("cut"); return accept; }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) { root.action("paste"); return accept; }
            if (event.text == Key.UpArrow) { root.cursor-moved(0 - root.vertical-step, event.modifiers.shift); return accept; }
            if (event.text == Key.DownArrow) { root.cursor-moved(root.vertical-step, event.modifiers.shift); return accept; }
            if (event.text == Key.LeftArrow && root.horizontal-step != 0) { root.cursor-moved(0 - root.horizontal-step, event.modifiers.shift); return accept; }
            if (event.text == Key.RightArrow && root.horizontal-step != 0) { root.cursor-moved(root.horizontal-step, event.modifiers.shift); return accept; }
            if (event.text == Key.PageUp) { root.cursor-moved(0 - root.page-step, event.modifiers.shift); return accept; }
            if (event.text == Key.PageDown) { root.cursor-moved(root.page-step, event.modifiers.shift); return accept; }
            if (event.text == Key.Home) { root.cursor-moved(-2147483647, event.modifiers.shift); return accept; }
            if (event.text == Key.End) { root.cursor-moved(2147483647, event.modifiers.shift); return accept; }
            if (event.text == Key.Return) { root.action("open"); return accept; }
            if (event.text == Key.Backspace) { root.go-up(); return accept; }
            if (event.text == Key.Delete) { root.action(event.modifiers.shift ? "delete-permanently" : "delete"); return accept; }
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) { root.action("select-all"); return accept; }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) { root.action("copy"); return accept; }
            if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) { root.text-typed(event.text); }
            reject
        }

        WindowMoveArea {
            y: 0;
            height: Theme.titlebar-height + Theme.toolbar-height;

            TouchArea {
                double-clicked => { root.maximized = !root.maximized; }
            }
        }

        VerticalLayout {
            TitleBar {
                icon: root.icon;
                title: root.title;
                maximized: root.maximized;
                minimize-requested => { root.minimized = true; }
                maximize-toggled => { root.maximized = !root.maximized; }
                close-requested => { root.close(); }
            }

            Rectangle {
                height: Theme.toolbar-height;
                background: transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 6px;
                    spacing: 3px;

                    IconButton {
                        icon: @image-url("icons/back.svg");
                        label: "Back";
                        enabled: root.can-go-back;
                        clicked => { root.go-back(); }
                    }

                    IconButton {
                        icon: @image-url("icons/forward.svg");
                        label: "Forward";
                        enabled: root.can-go-forward;
                        clicked => { root.go-forward(); }
                    }

                    IconButton {
                        icon: @image-url("icons/up.svg");
                        label: "Up one level";
                        enabled: root.can-go-up;
                        clicked => { root.go-up(); }
                    }

                    IconButton {
                        icon: root.busy ? @image-url("icons/stop.svg") : @image-url("icons/refresh.svg");
                        label: root.busy ? "Stop" : "Refresh";
                        clicked => { root.refresh-or-stop(); }
                    }

                    Rectangle { width: 6px; }

                    breadcrumbs := Breadcrumbs {
                        crumbs: root.crumbs;
                        path: root.current-path;
                        crumb-clicked(target) => { root.open-location(target); }
                        path-entered(text) => { root.path-entered(text); }
                    }

                    Rectangle { width: 6px; }

                    search-box := SearchBox {
                        width: 260px;
                        enabled: root.can-search;
                        placeholder-text: "Search this folder";
                        text <=> root.search-text;
                        edited => { root.search-changed(); }
                        accepted => { root.search-changed(); }
                        cleared => {
                            root.search-changed();
                            root.focus-list();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            Rectangle {
                height: Theme.commandbar-height;
                background: Theme.commandbar;

                TouchArea {
                    enabled: header-popover.open;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            header-popover.open = false;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 3px;

                    CommandButton {
                        icon: @image-url("icons/new-folder.svg");
                        text: "New folder";
                        enabled: root.can-edit-folder;
                        clicked => {
                            header-popover.open = false;
                            root.action("new-folder");
                        }
                    }

                    Rectangle {
                        width: 13px;

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            background: Theme.line;
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/cut.svg");
                        label: "Cut";
                        enabled: root.selected-count > 0;
                        clicked => {
                            header-popover.open = false;
                            root.action("cut");
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/copy.svg");
                        label: "Copy";
                        enabled: root.selected-count > 0;
                        clicked => {
                            header-popover.open = false;
                            root.action("copy");
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/paste.svg");
                        label: "Paste";
                        enabled: root.can-edit-folder;
                        clicked => {
                            header-popover.open = false;
                            root.action("paste");
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/rename.svg");
                        label: "Rename";
                        enabled: root.single-selection;
                        clicked => {
                            header-popover.open = false;
                            root.action("rename");
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/delete.svg");
                        label: "Move to Recycle Bin";
                        enabled: root.selected-count > 0;
                        clicked => {
                            header-popover.open = false;
                            root.action("delete");
                        }
                    }

                    Rectangle {
                        width: 13px;

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            background: Theme.line;
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/sort.svg");
                        text: "Sort";
                        opens-menu: true;
                        active: header-popover.open && root.header-menu == 1;
                        enabled: !root.showing-drives;
                        clicked => {
                            root.show-header-menu(1, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }

                    CommandButton {
                        icon: @image-url("icons/view.svg");
                        text: "View";
                        opens-menu: true;
                        active: header-popover.open && root.header-menu == 2;
                        clicked => {
                            root.show-header-menu(2, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }

                    Rectangle {
                        width: 13px;

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            background: Theme.line;
                        }
                    }

                    IconButton {
                        height: 32px;
                        icon: @image-url("icons/more.svg");
                        label: "More options";
                        active: header-popover.open && root.header-menu == 3;
                        clicked => {
                            root.show-header-menu(3, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        height: 32px;
                        icon: @image-url("icons/filter.svg");
                        label: "Search filters";
                        active: root.filters-open || root.size-enabled || root.date-enabled;
                        enabled: root.can-search;
                        clicked => {
                            header-popover.open = false;
                            root.filters-open = !root.filters-open;
                        }
                    }

                    IconButton {
                        height: 32px;
                        icon: @image-url("icons/summary.svg");
                        label: "Summary pane";
                        active: root.summary-open;
                        clicked => {
                            header-popover.open = false;
                            root.summary-open = !root.summary-open;
                            root.summary-toggled();
                        }
                    }

                    IconButton {
                        height: 32px;
                        icon: Theme.dark ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                        label: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                        clicked => {
                            header-popover.open = false;
                            Palette.color-scheme = Theme.dark ? ColorScheme.light : ColorScheme.dark;
                        }
                    }
                }
            }

            Rectangle {
                height: root.filters-open ? 45px : 0px;
                background: Theme.subtle-surface;
                clip: true;
                animate height { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }

                SearchFilters {
                    y: 1px;
                    width: parent.width;
                    size-enabled <=> root.size-enabled;
                    size-rule <=> root.size-rule;
                    size-text <=> root.size-text;
                    date-enabled <=> root.date-enabled;
                    date-field <=> root.date-field;
                    date-rule <=> root.date-rule;
                    date-text <=> root.date-text;
                    changed => { root.search-changed(); }
                }
            }

            Rectangle {
                height: root.busy ? 2px : 1px;
                background: Theme.line;

                IndeterminateBar {
                    width: parent.width;
                    active: root.busy;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Rectangle {
                    width: root.sidebar-width;
                    background: Theme.panel;

                    sidebar := Sidebar {
                        width: parent.width;
                        height: parent.height;
                        rows: root.tree-rows;
                        opened(index) => { root.tree-opened(index); }
                        toggled(index) => { root.tree-toggled(index); }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: sidebar-resize.has-hover || sidebar-resize.pressed ? Theme.accent : Theme.line;

                    sidebar-resize := TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 140px, 520px);
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface;

                    Rectangle {
                        horizontal-stretch: 1;

                        if root.showing-drives: DrivesView {
                            width: parent.width;
                            height: parent.height;
                            drives: root.drives;
                            network-drives: root.network-drives;
                            opened(path) => { root.open-location(path); }
                        }

                        list-menu := ContextMenuArea {
                            width: parent.width;
                            height: parent.height;
                            enabled: false;

                            Menu {
                                MenuItem {
                                    title: "Open";
                                    enabled: root.selected-count > 0;
                                    activated => { root.action("open"); }
                                }

                                MenuItem {
                                    title: "Open containing folder";
                                    enabled: root.single-selection && root.in-search-results;
                                    activated => { root.action("open-location"); }
                                }

                                MenuItem {
                                    title: "Show in File Explorer";
                                    enabled: root.single-selection;
                                    activated => { root.action("reveal"); }
                                }

                                MenuSeparator { }

                                MenuItem {
                                    title: "Cut";
                                    enabled: root.selected-count > 0;
                                    activated => { root.action("cut"); }
                                }

                                MenuItem {
                                    title: "Copy";
                                    enabled: root.selected-count > 0;
                                    activated => { root.action("copy"); }
                                }

                                MenuItem {
                                    title: "Paste";
                                    enabled: root.can-paste;
                                    activated => { root.action("paste"); }
                                }

                                MenuItem {
                                    title: "Copy path";
                                    enabled: root.selected-count > 0;
                                    activated => { root.action("copy-path"); }
                                }

                                MenuSeparator { }

                                MenuItem {
                                    title: "Rename";
                                    enabled: root.single-selection;
                                    activated => { root.action("rename"); }
                                }

                                MenuItem {
                                    title: "New folder";
                                    enabled: root.can-edit-folder;
                                    activated => { root.action("new-folder"); }
                                }

                                MenuSeparator { }

                                Menu {
                                    title: "View";
                                    for title[index] in root.view-titles: MenuItem {
                                        title: title;
                                        checkable: true;
                                        checked: index == root.view-index;
                                        activated => { root.view-chosen(index); }
                                    }
                                }

                                Menu {
                                    title: "Sort by";
                                    for choice[index] in root.sort-choices: MenuItem {
                                        title: choice.title;
                                        checkable: true;
                                        checked: choice.shown;
                                        activated => { root.sort-chosen(index); }
                                    }
                                }

                                MenuItem {
                                    title: "Select all";
                                    activated => { root.action("select-all"); }
                                }

                                MenuItem {
                                    title: "Invert selection";
                                    activated => { root.action("select-inverse"); }
                                }

                                MenuSeparator { }

                                MenuItem {
                                    title: "Recalculate";
                                    enabled: root.selected-count > 0 && !root.in-search-results;
                                    activated => { root.action("recalculate"); }
                                }

                                MenuItem {
                                    title: "Refresh";
                                    activated => { root.action("refresh"); }
                                }

                                MenuSeparator { }

                                MenuItem {
                                    title: "Move to Recycle Bin";
                                    enabled: root.selected-count > 0;
                                    activated => { root.action("delete"); }
                                }

                                MenuItem {
                                    title: "Properties";
                                    enabled: root.single-selection;
                                    activated => { root.action("properties"); }
                                }
                            }

                            property <length> banner-height: !root.showing-drives && root.in-search-results ? 36px : 0px;
                            animate banner-height { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                            if !root.showing-drives && banner-height > 0px: Rectangle {
                                y: 0;
                                width: parent.width;
                                height: banner-height;
                                background: Theme.selected;
                                clip: true;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 8px;

                                    Image {
                                        source: @image-url("icons/search.svg");
                                        width: 14px;
                                        colorize: Theme.accent;
                                    }

                                    Label {
                                        text: root.search-text != ""
                                            ? "Search results for \"" + root.search-text + "\" in " + root.current-path
                                            : "Filtered items in " + root.current-path;
                                        font-weight: 500;
                                        horizontal-stretch: 1;
                                    }

                                    CommandButton {
                                        icon: @image-url("icons/stop.svg");
                                        text: "Back to folder";
                                        clicked => { root.go-back(); }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Theme.selected-border;
                                }
                            }

                            table := FileTable {
                                y: banner-height;
                                width: parent.width;
                                height: parent.height - banner-height;
                                visible: !root.showing-drives && root.details;
                                columns: root.columns;
                                rows: root.details ? root.rows : [];
                                total-width: root.columns-width;
                                empty-message: root.list-message;
                                sort-requested(index) => { root.sort-requested(index); }
                                column-resized(index, width) => { root.column-resized(index, width); }
                                row-pressed(index, control, shift) => { root.row-pressed(index, control, shift); }
                                row-menu(index, x, y) => {
                                    root.row-context(index);
                                    root.menu-opening();
                                    list-menu.show({ x: x - list-menu.absolute-position.x, y: y - list-menu.absolute-position.y });
                                }
                                background-menu(x, y) => {
                                    root.menu-opening();
                                    list-menu.show({ x: x - list-menu.absolute-position.x, y: y - list-menu.absolute-position.y });
                                }
                                background-pressed => { root.background-pressed(); }
                                row-activated(index) => { root.row-activated(index); }
                                rename-committed(text) => { root.rename-committed(text); }
                                rename-cancelled => { root.rename-cancelled(); }
                            }

                            grid := FileGrid {
                                y: banner-height;
                                width: parent.width;
                                height: parent.height - banner-height;
                                visible: !root.showing-drives && !root.details;
                                view: root.view-index;
                                rows: root.details ? [] : root.rows;
                                empty-message: root.list-message;
                                row-pressed(index, control, shift) => { root.row-pressed(index, control, shift); }
                                row-menu(index, x, y) => {
                                    root.row-context(index);
                                    root.menu-opening();
                                    list-menu.show({ x: x - list-menu.absolute-position.x, y: y - list-menu.absolute-position.y });
                                }
                                background-menu(x, y) => {
                                    root.menu-opening();
                                    list-menu.show({ x: x - list-menu.absolute-position.x, y: y - list-menu.absolute-position.y });
                                }
                                background-pressed => { root.background-pressed(); }
                                row-activated(index) => { root.row-activated(index); }
                                rename-committed(text) => { root.rename-committed(text); }
                                rename-cancelled => { root.rename-cancelled(); }
                            }
                        }
                    }

                    StorageDock {
                        drives: root.drives;
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        open-location(path) => { root.open-location(path); }
                    }
                }

                if root.summary-open: Rectangle {
                    width: 1px;
                    background: summary-resize.has-hover || summary-resize.pressed ? Theme.accent : Theme.line;

                    summary-resize := TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            if (self.pressed) {
                                root.summary-width = clamp(root.summary-width - self.mouse-x + self.pressed-x, 260px, 560px);
                            }
                        }
                    }
                }

                if root.summary-open: Rectangle {
                    width: root.summary-width;
                    background: Theme.panel;

                    SummaryPane {
                        width: parent.width;
                        height: parent.height;
                        rows: root.summary-rows;
                        treemap-tiles: root.summary-treemap;
                        chart-image: root.summary-chart-image;
                        total-size: root.summary-total-size;
                        kind: root.summary-kind;
                        viz-mode <=> root.summary-viz-mode;
                        hovered-index <=> root.summary-hovered-index;
                        hint: root.summary-hint;
                        kind-chosen(index) => { root.summary-kind-chosen(index); }
                        viz-mode-chosen(mode) => { root.summary-viz-mode-chosen(mode); }
                        wheel-hovered(nx, ny) => { root.summary-wheel-hovered(nx, ny); }
                        row-hovered(index) => { root.summary-row-hovered(index); }
                        activated(index) => { root.summary-activated(index); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            Rectangle {
                height: Theme.statusbar-height;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;

                    DimLabel {
                        text: root.status-items;
                        font-weight: 500;
                        horizontal-stretch: 0;
                    }

                    if root.status-selection != "": Rectangle {
                        width: 1px;

                        Rectangle {
                            width: 1px;
                            height: 14px;
                            background: Theme.line;
                        }
                    }

                    if root.status-selection != "": DimLabel {
                        text: root.status-selection;
                        horizontal-stretch: 0;
                    }

                    if root.busy || root.status-activity != "": Rectangle {
                        width: 1px;

                        Rectangle {
                            width: 1px;
                            height: 14px;
                            background: Theme.line;
                        }
                    }

                    if root.busy: Rectangle {
                        width: 15px;

                        LoadingSpinner {
                            size: 14px;
                            tint: Theme.accent;
                        }
                    }

                    DimLabel {
                        text: root.status-activity;
                        horizontal-stretch: 1;
                    }

                    if root.status-errors != "": Rectangle {
                        min-width: warning-text.preferred-width + 32px;
                        horizontal-stretch: 0;

                        Rectangle {
                            height: 22px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: err-touch.has-hover ? Theme.warning : transparent;
                            background: err-touch.pressed ? Theme.pressed : Theme.warning-bg;

                            Image {
                                x: 7px;
                                width: 13px;
                                height: 13px;
                                source: @image-url("icons/warning.svg");
                                colorize: Theme.warning;
                            }

                            warning-text := DimLabel {
                                x: 24px;
                                height: parent.height;
                                font-weight: 600;
                                color: Theme.warning;
                                text: root.status-errors;
                            }
                        }

                        err-touch := TouchArea {
                            clicked => { root.errors-open = true; }
                        }
                    }

                    if root.disk-text != "": Rectangle {
                        width: 1px;

                        Rectangle {
                            width: 1px;
                            height: 14px;
                            background: Theme.line;
                        }
                    }

                    if root.disk-text != "": HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;

                        DimLabel {
                            text: root.disk-text;
                        }

                        Rectangle {
                            width: 96px;

                            UsageBar {
                                width: parent.width;
                                ratio: root.disk-ratio;
                                nearly-full: root.disk-nearly-full;
                            }
                        }
                    }
                }
            }
        }
    }

    header-popover := MenuPopover {
        width: root.width;
        height: root.height;
        anchor-x: root.menu-anchor-x;
        anchor-y: root.menu-anchor-y;
        item-count: root.header-menu == 1 ? root.sort-choices.length
            : root.header-menu == 2 ? root.view-titles.length
            : root.more-titles.length;
        submenu-item-count: self.submenu-open == 1 ? root.unit-titles.length
            : self.submenu-open == 2 ? root.column-choices.length
            : 0;
        activated(index) => { root.activate-header-item(index); }
        submenu-activated(index) => { root.activate-submenu-item(index); }
        open-submenu(index) => {
            if (root.header-menu == 3 && index < 2) {
                self.submenu-open = index + 1;
                self.submenu-index = 0;
            }
        }
        dismissed => { root.focus-list(); }

        if root.header-menu == 1: VerticalLayout {
            spacing: 1px;
            for choice[index] in root.sort-choices: PopoverItem {
                text: choice.title;
                checked: choice.shown;
                checkable: true;
                radio: true;
                highlighted: header-popover.current-index == index;
                hovered => { header-popover.current-index = index; }
                activated => { root.activate-header-item(index); }
            }
        }
        if root.header-menu == 2: VerticalLayout {
            spacing: 1px;
            for title[index] in root.view-titles: PopoverItem {
                text: title;
                icon: root.view-icons[index];
                checked: root.view-index == index;
                checkable: true;
                radio: true;
                highlighted: header-popover.current-index == index;
                hovered => { header-popover.current-index = index; }
                activated => { root.activate-header-item(index); }
            }
        }
        if root.header-menu == 3: VerticalLayout {
            spacing: 1px;
            for title[index] in root.more-titles: PopoverItem {
                text: title;
                icon: root.more-icons[index];
                checked: index == 2 && root.show-hidden;
                checkable: index == 2;
                enabled: index != 3 || !root.showing-drives;
                submenu: index < 2;
                active-submenu: index < 2 && header-popover.submenu-open == index + 1;
                separator-before: index == 3;
                highlighted: header-popover.current-index == index;
                hovered => {
                    header-popover.current-index = index;
                    header-popover.submenu-index = -1;
                    header-popover.submenu-open = index < 2 ? index + 1 : 0;
                }
                activated => { root.activate-header-item(index); }
            }
        }
    }

    SubmenuPopover {
        window-width: root.width;
        window-height: root.height;
        open: header-popover.open && root.header-menu == 3 && header-popover.submenu-open != 0;
        parent-x: header-popover.panel-x;
        parent-y: header-popover.panel-y;
        parent-width: header-popover.panel-width;
        offset-y: header-popover.displayed-submenu == 2 ? 35px : 0px;

        if header-popover.displayed-submenu == 1: VerticalLayout {
            spacing: 1px;
            for title[index] in root.unit-titles: PopoverItem {
                text: title;
                checked: root.unit-index == index;
                checkable: true;
                radio: true;
                highlighted: header-popover.submenu-index == index;
                hovered => {
                    header-popover.current-index = 0;
                    header-popover.submenu-index = index;
                }
                activated => { root.activate-submenu-item(index); }
            }
        }
        if header-popover.displayed-submenu == 2: VerticalLayout {
            spacing: 1px;
            for choice[index] in root.column-choices: PopoverItem {
                text: choice.title;
                checked: choice.shown;
                checkable: true;
                highlighted: header-popover.submenu-index == index;
                hovered => {
                    header-popover.current-index = 1;
                    header-popover.submenu-index = index;
                }
                activated => { root.activate-submenu-item(index); }
            }
        }
    }

    if root.errors-open: Rectangle {
        y: Theme.titlebar-height;
        width: root.width;
        height: root.height - Theme.titlebar-height;
        background: Theme.backdrop;

        TouchArea {
            clicked => { root.errors-open = false; }
        }

        ErrorPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 80px, 760px);
            height: min(parent.height - 80px, 520px);
            errors: root.errors;
            closed => { root.errors-open = false; }
        }
    }
}
