import { Theme } from "theme.slint";
import { DriveCard } from "types.slint";

// A circular usage gauge: a full track ring with a filled arc for the used
// fraction, drawn clockwise from 12 o'clock.
component UsageRing inherits Rectangle {
    in property <float> ratio;
    in property <color> fill;

    property <float> pct: min(max(root.ratio, 0), 0.999);
    property <angle> sweep: root.pct * 360deg;

    Rectangle {
        border-radius: self.width / 2;
        border-width: 4px;
        border-color: Theme.track;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: root.fill;
        stroke-width: 4px;
        MoveTo {
            x: 50;
            y: 6;
        }
        ArcTo {
            radius-x: 44;
            radius-y: 44;
            x: 50 + 44 * sin(root.sweep);
            y: 50 - 44 * cos(root.sweep);
            large-arc: root.pct > 0.5;
            sweep: true;
        }
    }
}

// One volume in the dock: usage ring plus name and free/total.
component StorageTile inherits Rectangle {
    in property <DriveCard> data;
    callback opened(string);

    width: 190px;
    border-radius: Theme.radius-lg;
    background: touch.has-hover ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.card-border;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        Rectangle {
            width: 36px;
            UsageRing {
                width: 36px;
                height: 36px;
                ratio: root.data.ratio;
                fill: root.data.nearly-full ? Theme.danger : Theme.accent;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.data.title;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            Text {
                text: root.data.detail;
                font-size: Theme.small-text-size;
                color: root.data.nearly-full ? Theme.danger : Theme.text-dim;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.opened(root.data.path);
        }
    }
}

// Floating, translucent storage bar pinned near the top of the file area.
export component StorageDock inherits Rectangle {
    in property <[DriveCard]> drives;
    callback open-location(string);

    visible: root.drives.length > 0;
    width: row.preferred-width;
    height: 60px;

    background: Theme.flyout;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.flyout-border;
    drop-shadow-blur: 24px;
    drop-shadow-color: Theme.backdrop;
    drop-shadow-offset-y: 6px;

    row := HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        for drive in root.drives: StorageTile {
            data: drive;
            opened(path) => {
                root.open-location(path);
            }
        }
    }
}
